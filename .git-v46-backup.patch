diff --git a/crates/orxnud-platform-sandbox/src/cgroup.rs b/crates/orxnud-platform-sandbox/src/cgroup.rs
index 334b9e9..61a2398 100644
--- a/crates/orxnud-platform-sandbox/src/cgroup.rs
